# Copy to .env and fill in. Never commit .env.
PORT=4000
SITE_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string-of-48-plus-characters

# First administrator (created automatically on first start when no users exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-10-chars
ADMIN_NAME=XYZ Administrator

# Database: leave DATABASE_URL empty to use the embedded PostgreSQL (PGlite) in ./data
DATABASE_URL=

# Email notifications (optional) ??? enquiries are stored either way
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=
